#!/bin/bash
set -euo pipefail

mkdir -p ~/.local/bin
mkdir -p ~/.local/share/zsh

# --- bootstrap mise (rootless, single binary, handles all tool archives/URLs/versions) ---
[[ -x ~/.local/bin/mise ]] || curl -fsSL https://mise.run | sh
export PATH="$HOME/.local/bin:$PATH"

# --- install all CLI tools via mise ---
mise install

# --- herdr (not in aqua registry, has its own installer) ---
[[ -x ~/.local/bin/herdr ]] || curl -fsSL https://herdr.dev/install.sh | sh

{{ if eq .chezmoi.os "darwin" -}}
# Mac: zsh is pre-installed (system or Homebrew). No extra steps needed.

{{ else -}}
# Linux: bootstrap micromamba if not present (rootless, single binary)
if ! command -v micromamba &>/dev/null && [[ ! -x ~/.local/bin/micromamba ]]; then
    curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C ~/.local/bin/ --strip-components=1 bin/micromamba
fi

# Linux: always install zsh to ~/.local/bin/zsh via micromamba (available on HPC nodes).
# Don't gate on 'command -v zsh' - login nodes have /usr/bin/zsh but compute nodes don't.
# Since home is NFS-shared, installing once makes zsh available on ALL nodes.
if [[ ! -x ~/.local/bin/zsh ]]; then
    micromamba create -y -n zsh zsh -c conda-forge >/dev/null 2>&1
    # micromamba installs to ~/.local/share/mamba/envs/ (not micromamba/)
    ln -sf ~/.local/share/mamba/envs/zsh/bin/zsh ~/.local/bin/zsh
fi

{{ end -}}

{{ if eq .chezmoi.os "darwin" -}}
# Mac: `file` cmd is pre-installed by the system.

{{ else -}}
# Linux: `file` cmd for MIME detection (yazi, other tools).
# Mac has it pre-installed; Linux HPC nodes often don't. micromamba install (rootless).
if [[ ! -x ~/.local/bin/file ]]; then
    micromamba create -y -n file file -c conda-forge >/dev/null 2>&1
    # micromamba installs to ~/.local/share/mamba/envs/ (not micromamba/)
    ln -sf ~/.local/share/mamba/envs/file/bin/file ~/.local/bin/file
fi

{{ end -}}

# --- zsh plugins (both platforms, git-cloned) ---
[[ -d ~/.local/share/zsh/zsh-autosuggestions ]] || \
    git clone --depth 1 https://github.com/zsh-users/zsh-autosuggestions ~/.local/share/zsh/zsh-autosuggestions
[[ -d ~/.local/share/zsh/zsh-syntax-highlighting ]] || \
    git clone --depth 1 https://github.com/zsh-users/zsh-syntax-highlighting ~/.local/share/zsh/zsh-syntax-highlighting
[[ -d ~/.local/share/zsh/zsh-history-substring-search ]] || \
    git clone --depth 1 https://github.com/zsh-users/zsh-history-substring-search ~/.local/share/zsh/zsh-history-substring-search

# --- NvChad (secondary nvim config, tried via NVIM_APPNAME=nvchad, not vendored here) ---
[[ -d ~/.config/nvchad ]] || \
    git clone --depth 1 https://github.com/NvChad/starter ~/.config/nvchad

echo "Tools installed. Run 'mise activate zsh' in your .zshrc to put mise-managed tools on PATH."
