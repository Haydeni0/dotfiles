#!/bin/bash
set -euo pipefail

mkdir -p ~/.local/bin
mkdir -p ~/.local/share/zsh

# --- bootstrap mise (rootless, single binary, handles all tool archives/URLs/versions) ---
[[ -x ~/.local/bin/mise ]] || curl -fsSL https://mise.run | sh
export PATH="$HOME/.local/bin:$PATH"

# --- install all CLI tools via mise (aqua backend handles archives automatically) ---
mise use -g starship zoxide fzf neovim bat ripgrep fd jq lazygit gh delta yazi gdu btop rclone uv

# --- herdr (not in aqua registry, has its own installer) ---
[[ -x ~/.local/bin/herdr ]] || curl -fsSL https://herdr.dev/install.sh | sh

{{ if eq .chezmoi.os "darwin" -}}
# Mac: zsh is pre-installed (system or Homebrew). No extra steps needed.

{{ else -}}
# Linux: zsh may not be pre-installed (compute nodes don't have it).
# Install via micromamba (available on HPC nodes) to ~/.local/bin/zsh.
if ! command -v zsh &>/dev/null; then
    if command -v micromamba &>/dev/null; then
        micromamba create -y -n zsh zsh -c conda-forge >/dev/null 2>&1
        ln -sf ~/.local/share/micromamba/envs/zsh/bin/zsh ~/.local/bin/zsh
    elif command -v conda &>/dev/null; then
        conda create -y -n zsh zsh -c conda-forge >/dev/null 2>&1
        ln -sf ~/miniconda3/envs/zsh/bin/zsh ~/.local/bin/zsh 2>/dev/null || \
        ln -sf ~/anaconda3/envs/zsh/bin/zsh ~/.local/bin/zsh 2>/dev/null
    else
        echo "Warning: zsh not found and no conda/micromamba available. Install zsh via your OS package manager."
    fi
fi

{{ end -}}

# --- zsh plugins (both platforms, git-cloned) ---
[[ -d ~/.local/share/zsh/zsh-autosuggestions ]] || \
    git clone --depth 1 https://github.com/zsh-users/zsh-autosuggestions ~/.local/share/zsh/zsh-autosuggestions
[[ -d ~/.local/share/zsh/zsh-syntax-highlighting ]] || \
    git clone --depth 1 https://github.com/zsh-users/zsh-syntax-highlighting ~/.local/share/zsh/zsh-syntax-highlighting
[[ -d ~/.local/share/zsh/zsh-history-substring-search ]] || \
    git clone --depth 1 https://github.com/zsh-users/zsh-history-substring-search ~/.local/share/zsh/zsh-history-substring-search

echo "Tools installed. Run 'mise activate zsh' in your .zshrc to put mise-managed tools on PATH."
