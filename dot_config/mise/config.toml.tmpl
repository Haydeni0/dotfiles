[tools]
fzf = "latest"
starship = "latest"
zoxide = "latest"
neovim = "latest"
bat = "latest"
ripgrep = "latest"
fd = "latest"
jq = "latest"
lazygit = "latest"
gh = "latest"
delta = "latest"
{{ if eq .chezmoi.os "darwin" -}}
yazi = "latest"
{{ else -}}
"http:yazi" = { version = "26.8.15", url = "https://github.com/sxyazi/yazi/releases/download/v26.8.15/yazi-{{ if eq .chezmoi.arch "amd64" }}x86_64{{ else }}aarch64{{ end }}-unknown-linux-musl.zip" }
btop = "latest"
{{ end -}}
gdu = "latest"
rclone = "latest"
uv = "latest"
difftastic = "latest"
glow = "latest"
# Pinned to 24: node 26.x links libatomic.so.1, absent on some Linux hosts (Rocky 9.7:
# "error while loading shared libraries: libatomic.so.1"). 24.x has no libatomic dependency.
node = "24"
# binary in release archives is `wt`, not `worktrunk` - the github backend finds it without an override
"github:max-sixty/worktrunk" = { version = "latest" }
