[tools]
fzf = "latest"
starship = "latest"
zoxide = "latest"
neovim = "latest"
bat = "latest"
ripgrep = "latest"
fd = "latest"
jq = "latest"
lazygit = "latest"
gh = "latest"
delta = "latest"
{{ if eq .chezmoi.os "darwin" -}}
yazi = "latest"
{{ else -}}
"http:yazi" = { version = "26.8.15", url = "https://github.com/sxyazi/yazi/releases/download/v26.8.15/yazi-{{ if eq .chezmoi.arch "amd64" }}x86_64{{ else }}aarch64{{ end }}-unknown-linux-musl.zip" }
btop = "latest"
{{ end -}}
gdu = "latest"
rclone = "latest"
uv = "latest"
difftastic = "latest"
glow = "latest"
node = "lts"

[tasks.test]
description = "Run dotfiles sanity, syntax, and multi-platform template tests"
run = "bash ${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi/scripts/test"

[tasks.sync]
description = "Pull latest dotfiles, apply, and test (the post-pull dance as one command)"
run = [
    "git -C ${XDG_DATA_HOME:-$HOME/.local/share}/chezmoi pull --ff-only",
    "chezmoi apply",
    "mise run test",
]

[tasks.doctor]
description = "Show chezmoi health and drift summary (files needing apply)"
run = [
    "chezmoi doctor",
    "echo '--- drift ---'",
    "chezmoi diff --exclude files",
    "echo '(empty above = clean)'",
]
