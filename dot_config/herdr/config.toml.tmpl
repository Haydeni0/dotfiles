{{ $zsh := "/bin/zsh" -}}
{{ if eq .chezmoi.os "linux" -}}{{ $zsh = (printf "%s/.local/bin/zsh" .chezmoi.homeDir) -}}{{ end -}}
{{- $theme := "dracula" -}}
{{- if eq .chezmoi.os "linux" -}}{{- $theme = "vesper" -}}{{- end -}}
{{- /* If per-OS differences grow beyond single fields, split into
     configs/herdr-darwin.toml + configs/herdr-linux.toml and include
     by OS instead of passing values. */ -}}
{{- includeTemplate "configs/herdr.toml" (dict "zshPath" $zsh "theme" $theme) -}}
