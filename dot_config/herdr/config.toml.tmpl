{{ $zsh := "/usr/bin/zsh" -}}
{{ if eq .chezmoi.os "darwin" -}}
{{   $zsh = "/bin/zsh" -}}
{{ else -}}
{{   $zsh = (printf "%s/.local/bin/zsh" .chezmoi.homeDir) -}}
{{ end -}}
{{- $theme := "dracula" -}}
{{- if eq .chezmoi.os "linux" -}}{{- $theme = "vesper" -}}{{- end -}}
{{- /* If per-OS differences grow beyond single fields, split into
     configs/herdr-darwin.toml + configs/herdr-linux.toml and include
     by OS instead of placeholder substitution. */ -}}
{{   include "configs/herdr.toml" | replace "ZSH_PATH_PLACEHOLDER" $zsh | replace "THEME_PLACEHOLDER" $theme -}}
