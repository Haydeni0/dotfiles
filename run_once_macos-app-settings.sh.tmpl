{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# GUI app settings (run once on first chezmoi apply on Mac).
# Sets keybinds/prefs for Rectangle, DockDoor, ScrollReverser via `defaults write`.
# Apps must be installed first (Brewfile casks) - run `brew bundle` before this.
# Apps may need a restart (or re-login) to pick up changes.

set -euo pipefail

echo "Setting GUI app defaults..."

# --- Rectangle (window keyboard shortcuts) ---
# Domain: com.knollsoft.Rectangle
# Maximize = ctrl+opt+cmd+uparrow (keyCode 126, modifierFlags 1835008 = cmd+opt+ctrl).
# allowAnyShortcut = permit arbitrary keybinds; alternateDefaultShortcuts = use Rectangle's
# alternate defaults; launchOnLogin = start at login.
defaults write com.knollsoft.Rectangle allowAnyShortcut -bool true
defaults write com.knollsoft.Rectangle alternateDefaultShortcuts -bool true
defaults write com.knollsoft.Rectangle launchOnLogin -bool true
defaults write com.knollsoft.Rectangle maximize -dict keyCode 126 modifierFlags 1835008
echo "  Rectangle: maximize=ctrl+opt+cmd+up, launchOnLogin"

# --- DockDoor (window peeking + alt-tab switcher) ---
# Domain: com.ethanbills.DockDoor. Free/open-source replacement for AltTab
# (which paywalled cmd+` window switching). All keybinds are plain UserDefaults
# values (string/int), so fully automatable - no GUI needed on a fresh Mac.
#
# Two switcher keybinds (alternate shares the main's modifier):
#   main (UserKeybind): cmd+tab  -> all-apps window switcher
#   alternate (cmd+`):           -> same-app (activeAppOnly) window switcher
# Sort order = recentlyUsed (last-used window first, not cyclic).
# UserKeybind is a JSON string (DockDoor's Defaults Codable serialization):
#   keyCode 48 = Tab, modifierFlags 1048840 = cmd (maskCommand) + capture bits.
# alternateKeybindKey 50 = grave_accent/backtick (the ISO key above Tab after
# Karabiner reshuffling). alternateKeybindMode = activeAppOnly.
defaults write com.ethanbills.DockDoor enableWindowSwitcher -bool true
defaults write com.ethanbills.DockDoor windowSwitcherSortOrder -string "recentlyUsed"
defaults write com.ethanbills.DockDoor UserKeybind -string '{"keyCode":48,"modifierFlags":1048840}'
defaults write com.ethanbills.DockDoor alternateKeybindKey -int 50
defaults write com.ethanbills.DockDoor alternateKeybindMode -string "activeAppOnly"
# GUI-customized prefs (captured via defaults read):
defaults write com.ethanbills.DockDoor enableCmdTabEnhancements -bool true
defaults write com.ethanbills.DockDoor requireShiftTabToGoBack -bool true
defaults write com.ethanbills.DockDoor switcherTrafficLightButtonsVisibility -string "never"
defaults write com.ethanbills.DockDoor switcherAppIconSize -int 29
echo "  DockDoor: cmd+tab=all-apps, cmd+\`=same-app (activeAppOnly), recentlyUsed order"

# --- ScrollReverser (fix scroll direction/acceleration for mice) ---
# Domain: com.pilotmoon.scroll-reverser
# InvertScrollingOn = invert scrolling (the app's master toggle).
# ReverseTrackpad = 0 = do NOT reverse trackpad (only reverse mouse).
# Conflicts with macOS "natural scrolling" - turn natural scrolling OFF in System Settings.
defaults write com.pilotmoon.scroll-reverser InvertScrollingOn -bool true
defaults write com.pilotmoon.scroll-reverser ReverseTrackpad -bool false
echo "  ScrollReverser: invert on, trackpad not reversed (mouse only)"

echo "GUI app defaults set. Restart Rectangle/DockDoor/ScrollReverser (or re-login) to apply."
echo "Note: turn OFF macOS 'natural scrolling' in System Settings for ScrollReverser to work."
{{ end -}}
