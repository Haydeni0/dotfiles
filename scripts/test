#!/usr/bin/env bash
set -euo pipefail

# Repo test suite. Fails loudly when a validator is missing - no silent skips.
# File discovery is dynamic (git ls-files) so it survives file moves.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

fail() { echo "ERROR: $*" >&2; exit 1; }

echo "==> 0. Validator presence"
for tool in bash zsh git rg jq uv chezmoi; do
    command -v "$tool" >/dev/null 2>&1 || fail "validator missing: $tool (mise/micromamba/system managed; install it)"
done

PLATFORMS=(
    '{"chezmoi":{"os":"darwin","arch":"arm64"}}'
    '{"chezmoi":{"os":"darwin","arch":"amd64"}}'
    '{"chezmoi":{"os":"linux","arch":"amd64"}}'
    '{"chezmoi":{"os":"linux","arch":"arm64"}}'
)

echo "==> 1. Shell syntax: plain shell sources + all rendered templates"
RENDERED="$(mktemp)"
trap 'rm -f "$RENDERED"' EXIT
shell_check() { # $1 = kind (zsh|bash|sh), $2 = content file
    case "$1" in
        zsh) zsh -n "$2" ;;
        bash) bash -n "$2" ;;
        sh)   sh -n "$2" ;;
    esac
}
kind_for() { # $1 = file basename
    case "$1" in
        *bashrc*|*bash_profile*) echo bash ;;
        # run_ scripts get bash -n even when #!/bin/sh: bash accepts POSIX sh
        # syntax (a superset), and the macos-defaults script is #!/bin/bash
        # with bash-only syntax that sh -n (dash) rejects
        *.sh*|run_once_*|run_onchange_*) echo bash ;;
        *) echo zsh ;;
    esac
}
is_shell_target() { # $1 = file path
    case "$(basename "$1")" in
        *zshrc*|*zshenv*|*zprofile*|*bashrc*|*bash_profile*|*aliases.zsh*|run_once_*|run_onchange_*|*.sh*) return 0 ;;
        *) return 1 ;;
    esac
}
# plain (non-template) shell sources, wherever they live; skip template
# fragments (e.g. configs/bashrc.linux - syntax-checked rendered instead)
while IFS= read -r f; do
    is_shell_target "$f" || continue
    grep -q '{{' "$f" && continue
    shell_check "$(kind_for "$(basename "$f")")" "$f"
done < <(git ls-files | grep -vE '\.tmpl$')
# every template whose target is a shell file, rendered per platform
for tmpl in $(git ls-files '*.tmpl'); do
    is_shell_target "${tmpl%.tmpl}" || continue
    kind="$(kind_for "$(basename "${tmpl%.tmpl}")")"
    for p in "${PLATFORMS[@]}"; do
        chezmoi execute-template --override-data "$p" < "$tmpl" > $RENDERED
        shell_check "$kind" $RENDERED
    done
done

echo "==> 2. Config formats: all tracked + all rendered TOML/YAML/JSON"
while IFS= read -r f; do jq empty "$f"; done < <(git ls-files '*.json')
while IFS= read -r f; do uv run --script scripts/validate_config.py toml "$f"; done < <(git ls-files '*.toml')
while IFS= read -r f; do uv run --script scripts/validate_config.py yaml "$f"; done < <(git ls-files | grep -E '\.ya?ml$' | grep -v Brewfile)
for tmpl in $(git ls-files '*.tmpl'); do
    base="${tmpl%.tmpl}"
    fmt=""
    case "$base" in
        *.toml) fmt=toml ;;
        *.yml|*.yaml) fmt=yaml ;;
        *.json) fmt=json ;;
    esac
    [ -z "$fmt" ] && continue
    for p in "${PLATFORMS[@]}"; do
        chezmoi execute-template --override-data "$p" < "$tmpl" > $RENDERED
        if [ "$fmt" = json ]; then jq empty $RENDERED
        else uv run --script scripts/validate_config.py "$fmt" $RENDERED; fi
    done
done

echo "==> 3. Rendered output: no leftover placeholders"
for tmpl in $(git ls-files '*.tmpl'); do
    for p in "${PLATFORMS[@]}"; do
        chezmoi execute-template --override-data "$p" < "$tmpl" > $RENDERED
        grep -nE 'PLACEHOLDER' $RENDERED && fail "leftover placeholder in rendered $tmpl ($p)"
    done
done
# .chezmoiignore is a live template without the .tmpl suffix - render it too
# (a template error there breaks every apply/diff/managed on all machines)
for p in "${PLATFORMS[@]}"; do
    chezmoi execute-template --override-data "$p" < .chezmoiignore > $RENDERED || fail ".chezmoiignore template error ($p)"
    grep -nE 'PLACEHOLDER' $RENDERED && fail "leftover placeholder in rendered .chezmoiignore ($p)"
done
chezmoi execute-template --override-data '{"chezmoi":{"os":"linux","arch":"amd64"}}' < .chezmoiignore | grep -qx 'Brewfile' || fail "linux .chezmoiignore must ignore Brewfile"
chezmoi execute-template --override-data '{"chezmoi":{"os":"darwin","arch":"arm64"}}' < .chezmoiignore | grep -qx 'Brewfile' && fail "darwin .chezmoiignore must deploy Brewfile" || true

echo "==> 4. CRLF check"
CRLF_FILES=$(git grep -I -l $'\r' -- . || true)
[ -n "$CRLF_FILES" ] && fail "CRLF line endings in: $CRLF_FILES"

echo "==> 5. Keybinding parity (zshrc discovered dynamically)"
ZSHRC=$(git ls-files | grep -E '(^dot_zshrc$|^configs/zshrc$)' | head -1)
[ -n "$ZSHRC" ] || fail "zshrc source not found"
for binding in "bindkey \$'\\e[1;3D' backward-word" "bindkey \$'\\e[1;3C' forward-word" \
                "bindkey \$'\\e[1;5D' backward-word" "bindkey \$'\\e[1;5C' forward-word"; do
    grep -F -q "$binding" "$ZSHRC" || fail "missing keybinding: $binding"
done

echo "==> 6. Invariants"
# no template-time lookPath
rg -n 'lookPath' --glob '*.tmpl' . && fail "lookPath in a template (use runtime guards)" || true
# template syntax requires .tmpl suffix on deployed dot_* entry points.
# Exempt: configs/ fragments (included templates, not deployed),
# .chezmoiignore (inherently a template), dot_config/worktrunk/* (worktrunk's
# own {{ }} templating, deployed verbatim by design).
while IFS= read -r f; do
    case "$f" in
        dot_config/worktrunk/*|*.tmpl) ;;
        *) fail "template syntax in deployed file $f without .tmpl suffix" ;;
    esac
done < <(git grep -l '{{' -- 'dot_*' || true)
# run_ scripts: a repo-installed tool resolves by absolute path/-x, never command -v alone
# (comment lines are prose about the rule, not code - skipped)
for s in $(git ls-files 'run_*.tmpl'); do
    for p in "${PLATFORMS[@]}"; do
        chezmoi execute-template --override-data "$p" < "$s" > $RENDERED
        while IFS= read -r line; do
            case "$line" in
                '#'*) ;;
                *"command -v git"*|*"command -v micromamba"*|*'-x '*) ;;
                *'command -v '*) fail "run_ script $s uses bare command -v: $line" ;;
            esac
        done < <(grep 'command -v' $RENDERED || true)
        # downloads go through fetch_verified (pinned sha256), never straight
        # into a shell or an extractor
        grep -nE '(curl|wget)[^|#]*\|[[:space:]]*(ba)?sh\b|(curl|wget)[^|#]*\|[[:space:]]*tar\b' $RENDERED \
            && fail "run_ script $s pipes a download into a shell/tar ($p) - use fetch_verified"
    done
done
# mise tools are exact pins: a floating request would ignore the lockfile entry
grep -vE '^[[:space:]]*#' dot_config/mise/config.toml | grep -nE '"(latest|lts)"' \
    && fail "dot_config/mise/config.toml has a floating version - pin it exactly and re-lock"
# externals keys and zshrc source paths must pair (R11)
if [ -f .chezmoiexternal.toml ]; then
    ZSHRC_SRC=$(git ls-files | grep -E '(^dot_zshrc$|^configs/zshrc$)' | head -1)
    while IFS= read -r key; do
        grep -q "$key" "$ZSHRC_SRC" || fail "externals key $key has no matching source guard in $ZSHRC_SRC"
    done < <(grep -oE '^\["[^"]+"\]' .chezmoiexternal.toml | tr -d '[""]')
    for plugin in zsh-autosuggestions zsh-syntax-highlighting zsh-history-substring-search; do
        grep -q "\.local/share/zsh/$plugin" .chezmoiexternal.toml || fail "plugin $plugin missing from .chezmoiexternal.toml"
    done
fi
# CLAUDE.md is a tracked symlink to AGENTS.md (one source, two names) - both
# the link and the identity must hold
[ "$(git ls-files -s CLAUDE.md | awk '{print $1}')" = "120000" ] || fail "CLAUDE.md must be a symlink to AGENTS.md (mode 120000), not a real copy"
cmp -s AGENTS.md CLAUDE.md || fail "AGENTS.md and CLAUDE.md differ"
# .chezmoiignore keeps its non-deploy sections
grep -q '^configs/' .chezmoiignore || fail "configs/ missing from .chezmoiignore"
grep -q '^scripts/' .chezmoiignore || fail "scripts/ missing from .chezmoiignore"

echo "==> All dotfiles tests passed successfully!"
