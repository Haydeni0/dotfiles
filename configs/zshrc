# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS EXTENDED_HISTORY HIST_REDUCE_BLANKS SHARE_HISTORY

# Editor
export EDITOR=nvim

# mise - puts mise-managed tools on PATH (starship, zoxide, fzf, bat, etc.)
# Must run before any command -v checks below, since mise provides the tools.
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate zsh)"
fi

# SSH agent - adds all private keys (both platforms)
if [ -z "$SSH_AUTH_SOCK" ]; then
    eval "$(ssh-agent -s)" > /dev/null
    find ~/.ssh -maxdepth 1 -type f -name "*.pub" -exec basename {} .pub \; | while read key; do
        ssh-add ~/.ssh/"$key" 2>/dev/null
    done
fi

# Keybindings (emacs mode)
bindkey -e
# Word = alphanumerics only, so backward-kill-word (ctrl+backspace) stops at
# / . - _ etc instead of eating whole paths/filenames. Default WORDCHARS treats
# those as word chars, killing "asdasd/asdasd" in one press.
WORDCHARS=''
bindkey '^H' backward-kill-word
# Word navigation: opt+left/right (macOS) and ctrl+left/right (WSL/Linux/xterm)
bindkey $'\e[1;3D' backward-word
bindkey $'\e[1;3C' forward-word
bindkey $'\e[1;5D' backward-word
bindkey $'\e[1;5C' forward-word
bindkey $'\e[5D' backward-word
bindkey $'\e[5C' forward-word
# opt+delete / ctrl+delete -> kill-word (ctrl+f12 via Karabiner -> opt+delete_forward;
# sequence arrives unbound and prints "3~" without this). Forward kill.
bindkey $'\e[3;3~' kill-word
bindkey $'\e[3;5~' kill-word
bindkey $'\e\e[3~' kill-word

# Completion
fpath+=~/.zfunc
autoload -Uz compinit
compinit -C
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' cache-path "$HOME/.cache/zsh"
zstyle ':completion:*:descriptions' format '%F{purple}%d%f'

# Aliases (shared)
[[ -r ~/.zsh/aliases.zsh ]] && source ~/.zsh/aliases.zsh

# Aliases (machine-local, not in dotfiles repo)
[[ -r ~/.zsh/aliases.local.zsh ]] && source ~/.zsh/aliases.local.zsh

# Prompt - starship if available, simple fallback
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init zsh)"

    # Transient prompt - collapse previous prompts to just the character (❯)
    # after command runs, keeping scrollback clean. Uses starship character module.
    # starship init sets PROMPT to a $(...) template re-evaluated via PROMPT_SUBST
    # on every redraw; save it so it can be restored before the next full prompt.
    __starship_full_prompt="$PROMPT"
    function zle-line-finish() {
        PROMPT=$(starship module character)
        zle .reset-prompt
    }
    zle -N zle-line-finish
    function __restore_starship_prompt() {
        PROMPT="$__starship_full_prompt"
    }
    precmd_functions+=(__restore_starship_prompt)
else
    autoload -Uz colors && colors
    PROMPT='%F{cyan}%~%f %F{purple}%#%f '
fi

# zoxide
export _ZO_EXCLUDE_DIRS="$HOME:$HOME/.cache/*:$HOME/.local/share/*:/tmp/*"
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
    _zoxide_complete() {
        [[ "${#words[@]}" -eq "${CURRENT}" ]] || return 0
        local -a dirs expl
        dirs=("${(@f)$(\command zoxide query -l -- ${words[2,-1]} 2>/dev/null | head -15)}")
        if (( ${#dirs} )); then
            compstate[insert]=menu
            compstate[list]=list
            _wanted directories expl 'zoxide' compadd -M '' -U -o nosort -a dirs
        fi
    }
    compdef _zoxide_complete z
fi

# fzf (requires fzf 0.48+ for --zsh flag)
# Preview opts: ctrl-t peeks at file content (dirs fall back to ls),
# alt-c peeks at the dir listing. ctrl-d toggles preview inside fzf.
# Must be set before `fzf --zsh` runs - the keybinds capture them at source.
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border --color=border:#bd93f9'
export FZF_CTRL_T_OPTS="--preview 'bat -p --color=always {} 2>/dev/null || ls -la {}' --bind ctrl-d:toggle-preview"
export FZF_ALT_C_OPTS="--preview 'ls -la {}' --bind ctrl-d:toggle-preview"
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi

# gssh: open a new WezTerm window running plain ssh (no local herdr layer).
# Remote auto-boots its own herdr; no nesting. Put ssh options before the host
# (e.g. `gssh -p 2222 user@host`), not after - ssh parses positionally.
# Uses `wezterm cli spawn --new-window` (not `wezterm start`) so the window
# joins the running instance - cmd+\ (ActivateWindowRelative) can cycle to it.
# Runs a retry-loop wrapper (not bare ssh) so the pane survives a dropped
# connection instead of exiting/closing: on any ssh exit (drop or clean
# logout) it waits 3s and reconnects. Ctrl-C during the sleep is the only
# way to stop the retries.
# WEZTERM_UNIX_SOCKET is unset: panes inherit it from the GUI that spawned
# them, but that GUI may have been quit since - the var then points at a
# dead socket and `wezterm cli` fails (tries to spawn a rival mux server,
# which loses the pid-file lock). Without it, cli finds the live instance.
# LC_HERDR_ALLOW_SPAWN=1 is sent on the FIRST connection only: it lets the
# remote zshrc spawn a herdr server if none is live (see the attach-only
# boot block at the bottom of this file). Reconnects never send it - a
# dropped connection must re-ATTACH, never silently spawn a fresh server
# (that is the "session reset" failure mode on NFS-shared-home clusters).
# LC_ prefix because sshd only AcceptEnv's LANG LC_* (same trick as SKIP_HERDR
# in sshh, which goes the other way).
if command -v wezterm >/dev/null 2>&1; then
    gssh() {
        env -u WEZTERM_UNIX_SOCKET wezterm cli spawn --new-window -- sh -c '
            first=1
            while true; do
                if [ "$first" = 1 ]; then
                    LC_HERDR_ALLOW_SPAWN=1 ssh -t "$@"
                else
                    ssh -t "$@"
                fi
                first=0
                status=$?
                echo "[gssh] disconnected ($status), reconnecting in 3s... (ctrl-c to stop)"
                sleep 3
            done
        ' sh "$@"
    }
fi

# sshh: plain ssh in the current terminal, with SKIP_HERDR=1 set on the remote
# so the remote shell does not auto-boot herdr. sshd's AcceptEnv (LANG LC_* only)
# blocks SendEnv/SetEnv passthrough, so the var is set by the remote command
# wrapper instead: the remote shell expands $SHELL (local quoting is preserved
# because ssh passes this as one argv element, not through a second sh -c) and
# execs the login shell; -t forces a TTY so the interactive shell gets one.
# Put ssh options before the host (e.g. `sshh -p 2222 user@host`), not after -
# ssh parses positionally.
sshh() {
    ssh -t "$@" 'SKIP_HERDR=1 exec $SHELL -l'
}

# lazygit: on macOS it defaults to ~/Library/Application Support/lazygit/
# instead of ~/.config/lazygit/ (its own docs suggest this override). Force
# XDG_CONFIG_HOME so the deployed dot_config/lazygit/config.yml.tmpl is the
# one file it reads on both Mac and Linux - no per-OS config split needed.
if command -v lazygit >/dev/null 2>&1; then
    alias lazygit='XDG_CONFIG_HOME="$HOME/.config" lazygit'
fi

# gdifft: git diff through difftastic's syntax-aware diff instead of delta,
# for trying it out one-off without touching core.pager.
if command -v difft >/dev/null 2>&1; then
    alias gdifft='GIT_EXTERNAL_DIFF=difft git diff'
fi

# nvchad: secondary nvim config to try out (cloned to ~/.config/nvchad, see
# run_once_install-tools.sh.tmpl). NVIM_APPNAME keeps its data/state/cache
# separate from the main nvim config too, so it's fully independent.
if command -v nvim >/dev/null 2>&1; then
    alias nvchad='NVIM_APPNAME=nvchad nvim'
fi

# Plugins (git-cloned to ~/.local/share/zsh/, source with guards)
[[ -r ~/.local/share/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh ]] && \
    source ~/.local/share/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh && \
    ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#5c6370'
[[ -r ~/.local/share/zsh/zsh-history-substring-search/zsh-history-substring-search.zsh ]] && \
    source ~/.local/share/zsh/zsh-history-substring-search/zsh-history-substring-search.zsh && \
    HISTORY_SUBSTRING_SEARCH_ENSURE_UNIQUE=1 && \
    bindkey '^[[A' history-substring-search-up && \
    bindkey '^[[B' history-substring-search-down
# Syntax highlighting MUST be last
[[ -r ~/.local/share/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]] && \
    source ~/.local/share/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# Auto-start herdr (primary multiplexer). tmux is backup (prefix ctrl-b).
# Set SKIP_HERDR=1 to drop to a plain shell. Set USE_TMUX=1 to start tmux instead.
# Guarded against nesting inside herdr/tmux panes, IDE terminals, and non-interactive shells.
#
# Two guards against the NFS-shared-home socket race (confirmed on the slurm
# cluster: seven servers ended up bound to the same socket path; a new ssh
# silently attached to an empty restored server and the session looked "reset"):
#
# 1. Per-host session name over ssh: "main-<hostname>" instead of "main".
#    Machines sharing an NFS home resolve different sockets + session.json
#    under sessions/<name>/, so they stop colliding.
# 2. Attach-only: before booting herdr, probe the session's server with
#    `herdr --session <name> status` (internally request-timeout-bounded in
#    herdr, so no external `timeout` needed - macOS has none). No live
#    server -> plain shell + a message, NEVER a silent spawn of a fresh
#    server. A spawn is only allowed when LC_HERDR_ALLOW_SPAWN=1 (set by
#    gssh's first connection - the LC_ prefix is what sshd AcceptEnv permits);
#    everything else - including gssh reconnects and plain `ssh host` - can
#    only attach. After a genuine reboot, run `herdr --session <name>` once.
if [[ -o interactive ]] && [ -z "$TMUX" ] && [ -z "$HERDR" ] && [ -z "$HERDR_ENV" ] && [ -z "$SKIP_HERDR" ] && \
   [ "$TERM_PROGRAM" != "vscode" ] && [ -z "${REMOTE_CONTAINERS_SOCKETS}" ] && \
   [ -z "${CURSOR_AGENT}" ]; then
    if [ -n "$USE_TMUX" ] && command -v tmux >/dev/null 2>&1; then
        exec tmux new-session -A -s main
    elif command -v herdr >/dev/null 2>&1; then
        _herdr_session=main
        [[ -n "$SSH_TTY" || -n "$SSH_CONNECTION" ]] && _herdr_session="main-$(hostname -s)"
        if herdr --session "$_herdr_session" status 2>/dev/null | grep -q "status: running"; then
            exec herdr --session "$_herdr_session"
        elif [ -n "$LC_HERDR_ALLOW_SPAWN" ]; then
            exec herdr --session "$_herdr_session"
        else
            echo "[herdr] no live session '$_herdr_session' on $(hostname -s); plain shell."
            echo "[herdr] start one with: herdr --session $_herdr_session"
        fi
        unset _herdr_session
    fi
fi
