# Managed env + PATH, read by every shell entry point: all zsh modes via
# ~/.zshenv, login bash via .bashrc. The only writer of PATH and exported
# env vars; rc files after it add interactive behavior on top.
# Prepends run oldest-target-first so the final order is:
# mise shims, brew dirs (darwin), ~/.local/bin, ~/.opencode/bin.
path_prepend() {
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1:$PATH" ;;
    esac
}
path_prepend "$HOME/.opencode/bin"
path_prepend "$HOME/.local/bin"
# mise shims - non-interactive shells (herdr panes, agent harnesses) inherit
# login-shell PATH but not `mise activate`; the shims dir makes mise-managed
# tools (wt, etc.) resolve there too. Interactive zsh additionally runs
# `mise activate zsh` (zshrc), which supersedes the shims.
path_prepend "$HOME/.local/share/mise/shims"
{{ if eq .chezmoi.os "darwin" -}}
# Homebrew. WezTerm tabs are non-login shells, so path_helper never adds
# the brew dirs there - without this, brew and brew-only tools (btop) are
# unreachable in every new tab. -d guard instead of the prefix hardcode:
# covers Apple Silicon (/opt/homebrew) and leaves Intel (/usr/local/bin,
# already on PATH via path_helper) untouched.
[[ -d /opt/homebrew/bin ]] && path_prepend /opt/homebrew/bin
[[ -d /opt/homebrew/sbin ]] && path_prepend /opt/homebrew/sbin
{{ end -}}
{{ if eq .chezmoi.os "linux" -}}
# Every Linux box is a work box - revisit when a non-work
# Linux machine exists.
export AWS_PROFILE=coreweave
{{ end -}}
export EDITOR=nvim
# Cross-tool telemetry opt-out standard (honored by codegraph and others):
# no usage stats, and codegraph skips its once-per-day GitHub update check too.
export DO_NOT_TRACK=1
# no-mistakes: kill usage-event POSTs to the vendor's telemetry host. Read by
# every zsh (zshenv), so the no-mistakes daemon's login-shell probe sees it too.
export NO_MISTAKES_TELEMETRY=0
unset -f path_prepend
