# PATH setup - runs for login shells on both platforms.
# Linux: login bash sources .bash_profile -> .bashrc (PATH) -> exec zsh -l -> zsh inherits.
# Mac: zsh is default shell, .zprofile runs directly.
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$PATH"

# mise shims - non-interactive shells (agent harnesses like herdr panes) inherit
# login-shell PATH but not `mise activate`; the shims dir makes mise-managed
# tools (wt, etc.) resolve there too. Interactive zsh additionally runs
# `mise activate zsh` (configs/zshrc), which supersedes the shims.
export PATH="$HOME/.local/share/mise/shims:$PATH"

# pi-node (user-specific, remove if not needed)
export PATH="$HOME/.local/share/pi-node/node-v22.23.1-linux-x64/bin:$PATH"

# no-mistakes: kill usage-event POSTs to the vendor's telemetry host.
# Exported here (not zshenv) so login shells - including the no-mistakes
# daemon's login-shell env probe at startup - always see it.
export NO_MISTAKES_TELEMETRY=0

