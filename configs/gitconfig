[include]
    path = ~/.gitconfig.local
[push]
    autoSetupRemote = true
[rerere]
    enabled = true
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    # side-by-side lives in a named feature (not a direct option) so it can
    # be selectively disabled per-invocation via `--features ""` - delta
    # ignores the features mechanism entirely for options set directly here.
    # Used to give lazygit a stacked diff view instead (see lazygit.yml).
    features = side-by-side
[delta "side-by-side"]
    side-by-side = true
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default
# gh-resolved HTTPS auth for private repos. gh auth setup-git writes a
# version-pinned absolute path into ~/.gitconfig on every `gh auth login`
# (drift chezmoi apply strips) - this bare PATH-resolved form is the
# repo-managed equivalent; re-login rewrites it back and needs re-stripping.
[credential "https://github.com"]
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper = !gh auth git-credential
