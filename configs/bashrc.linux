# Login bash sources .bash_profile -> this file. Env/PATH must be set before
# the interactive check - ssh runs `bash -l` which is non-interactive but
# needs PATH to find zsh.
{{ includeTemplate "configs/env.sh.tmpl" . -}}

# mise - puts mise-managed tools on PATH
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

# Return early for non-interactive shells (env/PATH already set above)
case $- in
    *i*) ;;
      *) return;;
esac

# Interactive shells: exec zsh (PATH-resolved - may be /usr/bin/zsh, ~/.local/bin/zsh, or mise-managed)
if [ -n "$PS1" ] && command -v zsh &>/dev/null; then
    exec zsh -l
fi
