# PATH setup (login bash sources .bash_profile -> .bashrc sets PATH, then exec zsh -l inherits)
# Must be before the interactive check - login shells need PATH even if non-interactive
# (e.g. SSH runs bash -l which is non-interactive but needs PATH to find zsh).
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.local/share/pi-node/node-v22.23.1-linux-x64/bin:$PATH"

# uv env (defensive - kept alongside other tools)
. "$HOME/.local/bin/env" 2>/dev/null

# mise - puts mise-managed tools on PATH
if command -v mise >/dev/null 2>&1; then
    eval "$(mise activate bash)"
fi

# Return early for non-interactive shells (after PATH/mise setup)
case $- in
    *i*) ;;
      *) return;;
esac

export AWS_PROFILE=coreweave

# Start herdr (primary multiplexer). tmux is backup (prefix ctrl-b).
# Set SKIP_HERDR=1 to drop to a plain shell. Set USE_TMUX=1 to start tmux instead.
if [ -n "$PS1" ] && [ -z "$TMUX" ] && [ -z "$HERDR" ] && [ -z "$SKIP_HERDR" ] && \
   [ "$TERM_PROGRAM" != "vscode" ] && [ -z "${REMOTE_CONTAINERS_SOCKETS}" ] && \
   [ -z "${CURSOR_AGENT}" ]; then
    if [ -n "$USE_TMUX" ] && command -v /usr/bin/tmux &>/dev/null; then
        exec /usr/bin/tmux new-session -A -s main
    elif command -v herdr &>/dev/null; then
        exec herdr --session main
    fi
fi

# Inside tmux: exec zsh (PATH-resolved - may be /usr/bin/zsh, ~/.local/bin/zsh, or mise-managed)
if [ -n "$PS1" ] && command -v zsh &>/dev/null; then
    exec zsh -l
fi
