{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Reload Karabiner-Elements after chezmoi deploys a config change.
# run_onchange_ re-runs when this script's rendered content changes. The two
# include lines below embed the karabiner config files, so editing either JSON
# changes the rendered hash and triggers this reload. They render as comments
# (no execution effect). run_onchange_after_ runs after dest files update, so
# the new config is in place when this fires.
# hash inputs:
# {{ include "dot_config/karabiner/karabiner.json" }}
# {{ include "dot_config/karabiner/assets/complex_modifications/1757349181.json" }}
set -euo pipefail

# Kickstart the per-user Karabiner daemon. -k kills the running instance first
# so it re-reads the config.
launchctl kickstart -k "gui/$(id -u)/org.pqrs.karabiner.karabiner_console_user_server" 2>/dev/null || {
    echo "Karabiner daemon not running (app may not be installed/launched yet)."
    echo "Launch Karabiner-Elements once to start its daemons; config is already in place."
}
{{- end -}}
