#!/bin/sh
# Link chezmoi-deployed herdr plugins. Idempotent: herdr plugin link on an
# already-linked path is a no-op, but check anyway to keep the run_once hash
# stable and the log quiet.
# `herdr` installs to ~/.local/bin (run_once_install-tools). Resolve by absolute
# path - chezmoi runs scripts with a PATH that may not include it (AGENTS.md).
# Missing tool = exit 1 so chezmoi retries on the next apply.
set -eu

HERDR="$HOME/.local/bin/herdr"
plugin_dir="$HOME/.local/share/herdr-plugins/numbered-workspaces"

if [ ! -x "$HERDR" ]; then
    echo "herdr-plugins: herdr not found at $HERDR - not installed yet; exiting 1 so chezmoi retries" >&2
    exit 1
fi

if [ -f "$plugin_dir/herdr-plugin.toml" ] && ! "$HERDR" plugin list 2>/dev/null | grep -q numbered-workspaces; then
    "$HERDR" plugin link "$plugin_dir"
    echo "herdr: linked numbered-workspaces"
fi
